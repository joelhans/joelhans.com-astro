---
import Main from '../../layouts/Main.astro';
import { getCollection } from 'astro:content';
import ReadingLink from '../../components/ReadingLink.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).filter(
  e => e.data.archive !== true,
);
---

<Main
  title="Thoughts"
  description="Writing, news, and notes from Joel Hans."
  pubDate={new Date('May 31 2025')}
>
  <div class="not-prose grid grid-cols-1 gap-8">
    {posts.map((post) => (
      <ReadingLink href={`/blog/${post.id}/`} title={post.data.title} date={post.data.pubDate} mode={post.data.mode ?? 'fiction'} />
    ))}
  </div>
</Main>
