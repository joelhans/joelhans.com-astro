---
import Main from '../layouts/Main.astro';
import PathMark from '../components/PathMark.astro';
import { getCollection } from 'astro:content';
import ReadingLink from '../components/ReadingLink.astro';

const posts = (await getCollection('blog'))
  .filter(e => e.data.archive !== true)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestFictionPost = posts.find(p => (p.data.mode ?? 'fiction') === 'fiction');
const latestTechPost = posts.find(p => p.data.mode === 'tech');
---

<Main
  title="Joel Hans"
  description="Joel Hans writes fiction and leads developer education and marketing."
  compact
>
  <div class="not-prose text-[#334155]">
    <section class="scroll-mt-8" id="fiction" aria-labelledby="fiction-heading">
      <div class="mb-6 flex items-center gap-3 sm:gap-6">
        <h1 id="fiction-heading" class="m-0 text-[clamp(1.5rem,3vw,2.25rem)] font-medium leading-[1.3] tracking-tight">I’m a fiction writer.</h1>
        <PathMark mode="fiction" class="w-10 sm:w-14" />
      </div>
      <div>
        <p class="mt-0 mb-5 text-xl leading-[1.7] lg:text-2xl">My debut short story collection, <span class="italic [font-variant:small-caps]">The Bedtime Emptying of Our World</span>, won the 2024 Moon City Short Fiction Award from Moon City Press.</p>
        <p class="mt-0 mb-5 text-xl leading-[1.7] lg:text-2xl"><a class="underline decoration-[#9aafa5] underline-offset-4 hover:text-[#047857] hover:decoration-current focus-visible:outline-2 focus-visible:outline-offset-[5px] focus-visible:outline-[#047857]" href="/collection/">Read more about the collection &rarr;</a></p>
        <p class="mt-0 mb-5 text-xl leading-[1.7] lg:text-2xl">My fiction has been published in <em>Fairy Tale Review</em>, <em>Story</em>, <em>West Branch</em>, <em>Booth: A Journal</em>, <em>Passages North</em>, <em>HAD</em>, and many others, and has been anthologized in <em>Best Small Fictions</em>. I received my MFA in fiction from the University of Arizona.</p>
      </div>
      <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <ReadingLink href="/stories/" title="Some of my published stories from the last decade" />
        {latestFictionPost && (
          <ReadingLink href={`/blog/${latestFictionPost.id}/`} date={latestFictionPost.data.pubDate} title={latestFictionPost.data.title} />
        )}
      </div>
    </section>

    <section class="mt-20 scroll-mt-8 lg:mt-24" id="tech" aria-labelledby="tech-heading">
      <div class="mb-6 flex items-center gap-3 sm:gap-6">
        <h2 id="tech-heading" class="m-0 text-[clamp(1.5rem,3vw,2.25rem)] font-medium leading-[1.3] tracking-tight">I also work in tech.</h2>
        <PathMark mode="tech" class="w-10 sm:w-14" />
      </div>
      <div>
        <p class="mt-0 mb-5 text-xl leading-[1.7] lg:text-2xl">I head up developer education, content, and the written half of brand at <a class="underline decoration-[#9aafa5] underline-offset-4 hover:text-[#047857] hover:decoration-current focus-visible:outline-2 focus-visible:outline-offset-[5px] focus-visible:outline-[#047857]" href="https://ngrok.com">ngrok</a> and I love it. Before that, I consulted for companies like Aikido Security, Rewind, Testkube, Zuplo, and Netdata through my (now-defunct, one-person) agency: Commit.</p>
        <p class="mt-0 mb-5 text-xl leading-[1.7] lg:text-2xl">My current passion project is building a <a class="underline decoration-[#9aafa5] underline-offset-4 hover:text-[#047857] hover:decoration-current focus-visible:outline-2 focus-visible:outline-offset-[5px] focus-visible:outline-[#047857]" href="https://github.com/ngrok/little-internet" target="_blank">little internet</a> on an old desk in my office so I can learn about the many brilliant invisible layers that make our lives possible.</p>
      </div>
      <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <ReadingLink href="/blog/?mode=tech" title="Noodlings on computers and the people who use them" />
        {latestTechPost && (
          <ReadingLink href={`/blog/${latestTechPost.id}/`} date={latestTechPost.data.pubDate} title={latestTechPost.data.title} />
        )}
      </div>
    </section>
  </div>
</Main>
