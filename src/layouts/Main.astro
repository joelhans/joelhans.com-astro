---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

const { title, description, pubDate, updatedDate, frontmatter, compact = false } = Astro.props;

---

<html lang="en">
	<head>
    <BaseHead title={title ?? frontmatter.title} description={description ?? frontmatter.description} />
  </head>
  <body class="text-slate-700 bg-[#ebf5f2] [html[data-mode=fiction]_&]:bg-[#f3f3e9] [html[data-mode=tech]_&]:bg-[#ecf1f7] motion-safe:transition-[background-color] motion-safe:duration-[420ms] motion-safe:ease-[ease]">
		<Header />
    <main class:list={["max-w-4xl m-auto px-8 font-body text-slate-700", compact ? 'pt-16 pb-24 lg:pt-24' : 'py-24 lg:py-48']}>
      <article class="prose lg:prose-xl prose-headings:font-medium prose-a:hover:text-emerald-600 max-w-full">
        <slot />
      </article>
		</main>
  </body>
</html>
